# TechNexus Environment Variables
# Copy this file to .env.local for local development
# Set these in Vercel Dashboard → Settings → Environment Variables for production

# ── TiDB Serverless (MySQL-compatible) ──────────────────────────
TIDB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=your_tidb_username
TIDB_PASSWORD=your_tidb_password
TIDB_DATABASE=technexus

# ── Flutterwave Payment Gateway ──────────────────────────────────
FLW_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxx-X
FLW_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxx-X
FLW_SECRET_HASH=your_flutterwave_webhook_hash

# ── Cloudinary Image Hosting ─────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_UPLOAD_PRESET=tn_products

# ── Auth & Security ───────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# ── Admin Panel ───────────────────────────────────────────────────
# Default PIN is TN2026 — change this before going live
ADMIN_PIN=TN2026
